Bootstrap: docker
From: ubuntu:22.04

%post -c /usr/bin/bash
    set -e

    apt-get update
    apt-get install -y libosmesa6-dev python3.10 python3.10-dev python3.10-minimal python3.10-venv build-essential patchelf git python-is-python3
    apt-get install -y libegl1 libgles2 libegl-dev mesa-utils

    # --- Build & install Slurm 25.11.3 from the official source tarball ---
    SLURM_VERSION=25.11.3
    SLURM_URL=https://github.com/SchedMD/slurm/releases/download/slurm-25-11-3-1/slurm-25.11.3.tar.bz2
    BUILD_DIR=/tmp/slurm-build

    apt-get install -y --no-install-recommends wget devscripts equivs fakeroot

    mkdir -p "${BUILD_DIR}"
    cd "${BUILD_DIR}"
    wget -O slurm.tar.bz2 "${SLURM_URL}"
    tar -xjf slurm.tar.bz2
    cd "slurm-${SLURM_VERSION}"

    mk-build-deps --install --remove \
        --tool='apt-get -y --no-install-recommends' \
        debian/control

    SRC_PKG=$(dpkg-parsechangelog -S Source)
    BUILD_DEPS_PKG="${SRC_PKG}-build-deps"

    dpkg-buildpackage -b -us -uc -j"$(nproc)"

    cd ..
    ls -la *.deb
    apt-get install -y ./slurm-smd-client_*.deb ./slurm-smd_*.deb

    apt-get purge -y "${BUILD_DEPS_PKG}" devscripts equivs fakeroot wget
    apt-get autoremove -y
    apt-get clean
    rm -rf "${BUILD_DIR}" /var/lib/apt/lists/*

%runscript
    echo "libosmesa6-dev has been successfully installed!"
    srun --version
